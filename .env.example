# ============ 内信 IntraChat 部署配置模板 ============
# 复制本文件为 .env 并按需修改。所有项均有默认值，但生产环境务必修改 JWT_SECRET 与管理员初始密码。

# ---- MySQL 数据库 ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=im_app
DB_PASSWORD=please-change-me
DB_NAME=intranet_im

# ---- 安全 ----
# 用于签发登录令牌的密钥，请设置为足够长的随机字符串
JWT_SECRET=please-change-to-a-long-random-string
# 登录令牌有效期（秒），默认 12 小时
TOKEN_TTL_SECONDS=43200

# ---- 文件存储（本地磁盘） ----
# 相对路径基于程序运行目录，也可写绝对路径，如 D:\intranet-im\uploads
UPLOAD_DIR=uploads
# 单文件大小上限（MB），需求基线：最高 100MB
MAX_UPLOAD_MB=100

# ---- 初始管理员 ----
# 仅在首次启动、库中没有任何管理员时生效，用于创建种子管理员账号
ADMIN_USERNAME=admin
ADMIN_INITIAL_PASSWORD=Admin@123456
ADMIN_DISPLAY_NAME=系统管理员

# ---- 服务端口（可选，默认 5000） ----
# PORT=5000
